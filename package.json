{
  "name": "forgeos-platform",
  "private": false,
  "version": "0.3.0-rc.1",
  "description": "ForgeOS enterprise AI-native application development, release, and operations platform built on the OpenAI Codex runtime.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azi9527/ForgeOS.git"
  },
  "homepage": "https://github.com/Azi9527/ForgeOS#readme",
  "bugs": {
    "url": "https://github.com/Azi9527/ForgeOS/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "forgeos": "./bin/codex-webui.mjs",
    "codex-webui": "./bin/codex-webui.mjs"
  },
  "files": [
    "bin",
    "build/static",
    "dist/backend",
    "docs",
    "scripts/gateway-data-backup.mjs",
    "scripts/gateway-release.mjs",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "cli": "node ./bin/codex-webui.mjs",
    "ws:debug": "node ./scripts/ws-debug-client.mjs",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie globalVariable baseLocale --is-server 'import.meta.env.SSR' --emit-ts-declarations",
    "dev": "pnpm paraglide:compile && vite dev",
    "build": "pnpm paraglide:compile && svelte-kit sync && node ./scripts/build-app.mjs",
    "build:e2e-fake": "cargo build --manifest-path backend/Cargo.toml --bin fake_codex_app_server",
    "build:cross": "node ./scripts/build-cross.mjs",
    "verify:api-parity": "node ./scripts/verify-api-parity.mjs",
    "verify:codex-compat": "node ./scripts/verify-codex-compat.mjs",
    "verify:codex-protocol": "pnpm verify:codex-compat",
    "verify:static-build": "node ./scripts/verify-static-build.mjs",
    "verify:security-regressions": "node ./scripts/verify-security-regressions.mjs",
    "verify:low-memory-smoke": "node ./scripts/verify-low-memory-smoke.mjs",
    "verify:tunnel-safety": "node ./scripts/verify-tunnel-safety.mjs",
    "test:frontend": "node --experimental-strip-types --test frontend-tests/*.test.mjs",
    "test:ws-client-backpressure": "node --test ./scripts/ws-client-backpressure.test.mjs",
    "test:gateway-release": "node --test ./scripts/gateway-release.test.mjs",
    "test:gateway-data": "node --test ./scripts/gateway-data-backup.test.mjs",
    "gateway:data": "node ./scripts/gateway-data-backup.mjs",
    "gateway:bundle": "node ./scripts/create-gateway-bundle.mjs",
    "gateway:dev": "setpriv --no-new-privs --inh-caps=-all --ambient-caps=-all cargo run --manifest-path backend/Cargo.toml",
    "gateway:check": "cargo check --manifest-path backend/Cargo.toml",
    "gateway:build": "cargo build --manifest-path backend/Cargo.toml",
    "preview": "vite preview",
    "check": "pnpm paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:e2e": "pnpm build && pnpm verify:static-build && pnpm verify:api-parity && pnpm build:e2e-fake && playwright test",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.16.0",
    "ws": "^8.20.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.48.4",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "autoprefixer": "^10.5.0",
    "hast-util-to-html": "^9.0.5",
    "lowlight": "^3.3.0",
    "lucide-svelte": "^1.0.1",
    "marked": "^17.0.0",
    "monaco-editor": "^0.55.1",
    "postcss": "^8.5.9",
    "svelte": "^5.39.6",
    "svelte-check": "^4.3.1",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.8"
  }
}
